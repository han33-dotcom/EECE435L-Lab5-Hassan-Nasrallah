    {
      "name": "01 Add user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/users/add",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "add"
          ]
        },
        "description": "01 Add user",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"067765434567\",\n  \"address\": \"John Doe Street, Innsbruck\",\n  \"country\": \"Austria\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"JSON response\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "const user = pm.response.json();",
              "pm.test(\"Generated user ID\", () => pm.expect(user.user_id).to.be.a(\"number\"));",
              "pm.test(\"Created fields match\", () => { const sent = JSON.parse(pm.request.body.raw); Object.keys(sent).forEach(k => pm.expect(user[k]).to.eql(sent[k])); });",
              "if (pm.response.code === 201) pm.environment.set(\"user_id\", user.user_id);"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "01 Add user successful response",
          "originalRequest": {
